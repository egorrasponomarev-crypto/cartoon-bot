# ===================================================================
# НАСТРОЙКИ БОТА
# Скопируй этот файл, назови копию .env (с точкой в начале) и заполни.
# После любых изменений перезапусти бота.
# ===================================================================

# --- Обязательное ---------------------------------------------------

# Токен бота от @BotFather (вида 1234567890:AAH...)
BOT_TOKEN=

# Твой Telegram ID (цифры). Узнать: @userinfobot или команда /myid в своём боте
ADMIN_ID=

# ID закрытого канала курса (начинается с -100). Узнать: перешли боту любой пост из канала
CHANNEL_ID=

# --- Оплата ---------------------------------------------------------

# preorder — оплаты в боте нет: после нажатия «🔥 Вступить за …» админу приходит уведомление (о первом нажатии),
#            а ученик получает кнопку в чат с автором (как «Нужна помощь») с готовым сообщением PREORDER_MESSAGE.
#            Цены в оффере — PRICE_FULL_TEXT и PRICE_DISCOUNT_TEXT в texts.py (настройки ниже не нужны).
#            Доступ в канал после оплаты выдаёшь командой /grant.
# stars — звёзды Telegram, link — ссылка на внешнюю оплату
PAYMENT_MODE=preorder

# Цены в рублях (показываются в оффере; в режиме link — это суммы к оплате)
PRICE_FULL_RUB=10000
PRICE_DISCOUNT_RUB=4990

# Цены в звёздах (для режима stars). Проверь, что Telegram принимает такую сумму (см. README)
PRICE_FULL_STARS=5000
PRICE_DISCOUNT_STARS=2500

# Ссылки на оплату (для режима link): полная цена и цена со скидкой.
# Внимание: правила Telegram требуют продавать цифровые товары в ботах за звёзды —
# режим link нарушает эти правила, бот могут ограничить.
PAYMENT_LINK_FULL=
PAYMENT_LINK_DISCOUNT=

# --- Скидка и напоминания (в часах) --------------------------------

# Сколько действует личная скидка с момента первого входа в бота
DISCOUNT_HOURS=24

# «Как там шаг N?» — через сколько часов после открытия шага
STEP_REMINDER_1_HOURS=24
STEP_REMINDER_2_HOURS=72

# «Давно не виделись» — через сколько часов тишины (168 = 7 дней)
INACTIVITY_HOURS=168

# Напоминание про курс: через сколько часов после экрана «Что дальше?» (или экрана цены, который бот прислал сам)
OFFER_REMINDER_HOURS=24

# «Скоро конец скидки» — за сколько часов до конца
LAST_CALL_HOURS=3

# true — «скоро конец скидки» и «скидка закончилась» получают все, кто не купил;
# false — только те, кто хотя бы раз открывал оффер
SALES_REMINDERS_FOR_ALL=true

# --- Ночь: не писать ученикам ночью ---------------------------------

# С QUIET_START до QUIET_END ночь; ночные сообщения переносятся на QUIET_SEND_AT
# (QUIET_SEND_AT должен быть вне ночи). Часы — от 0 до 23, время — TIMEZONE.
QUIET_HOURS=true
QUIET_START=23
QUIET_END=9
QUIET_SEND_AT=10
TIMEZONE=Europe/Moscow

# --- Тестовый режим -------------------------------------------------

# true — все «часы» становятся короче (по умолчанию 1 час = 1 минута), ночное правило выключено
TEST_MODE=false
# Сколько секунд длится один «час» в тестовом режиме (60 = минута, 10 = 10 секунд)
TEST_HOUR_SECONDS=60

# --- Кнопка «Нужна помощь» ------------------------------------------

# Куда ведёт кнопка «🆘 Нужна помощь» под шагами. Пусто — в чат с админом (бот сам возьмёт его username).
# Можно указать другой аккаунт: https://t.me/username или просто @username
HELP_URL=

# --- Картинка над длинным текстом -----------------------------------

# Подпись к фото в Telegram — до 1024 символов. Если текст шага длиннее, бот показывает картинку
# крупным превью над текстом (одним сообщением). Для этого он кладёт картинку в папку веб-сервера:
# MEDIA_WEB_DIR — папка, MEDIA_BASE_URL — её адрес в интернете. Пусто — картинка придёт отдельным сообщением.
# Пример для сервера с nginx: MEDIA_WEB_DIR=/var/www/html/kyrs-media и MEDIA_BASE_URL=https://твой-домен.ru/kyrs-media
# Нужен адрес с доменом: ссылку с IP-адресом (http://1.2.3.4/...) Telegram не принимает.
# Своего домена нет — подойдёт бесплатный адрес sslip.io: MEDIA_BASE_URL=http://1.2.3.4.sslip.io/kyrs-media
# (вместо 1.2.3.4 — IP твоего сервера; такой адрес ведёт на тот же сервер).
MEDIA_WEB_DIR=
MEDIA_BASE_URL=

# --- Прочее ---------------------------------------------------------

# Пауза между сообщениями рассылки, в секундах (0.05 = 20 сообщений в секунду)
BROADCAST_DELAY=0.05

# Файл базы данных
DB_PATH=bot.db

# Прокси для связи с Telegram — нужен, только если бот запускается там, где Telegram заблокирован.
# Пример: socks5://логин:пароль@1.2.3.4:1080  или  http://1.2.3.4:3128  (порт обязателен).
# MTProto-прокси (ссылки tg://proxy...) для ботов НЕ подходят. Спецсимволы в пароле: @ → %40, # → %23
PROXY=
